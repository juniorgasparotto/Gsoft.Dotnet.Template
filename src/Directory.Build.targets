<!-- Importado automaticamente ao final de cada projeto (equivalente ao Directory.Build.props) -->
<Project>

  <!-- BuildEnv na raiz de src -->
  <Import Project="$(MSBuildThisFileDirectory).Build\Targets\BuildEnv.targets" Condition="('$(IsUiProject)' == 'true' OR '$(IsWorkerProject)' == 'true') AND Exists('$(MSBuildThisFileDirectory).Build\Targets\BuildEnv.targets')" />

</Project>
