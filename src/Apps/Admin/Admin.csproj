<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UseAppsConfig>true</UseAppsConfig>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Admin</AssemblyName>
    <RootNamespace>Admin</RootNamespace>
    <RazorLangVersion>Latest</RazorLangVersion>
    <UserSecretsId>dotnet-Admin-7b950930-11ad-4898-9511-f546f6cdbd8b</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)Apps\Config\Apps.Config.csproj" />
    <ProjectReference Include="$(RepoRoot)Apps\Databases\UI\SqliteBrowser.UI\SqliteBrowser.UI.csproj" />
    <ProjectReference Include="$(RepoRoot)Apps\ToDoSystem\Worker\ToDoSystem.Worker.Jobs\ToDoSystem.Worker.Jobs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update=".env">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
