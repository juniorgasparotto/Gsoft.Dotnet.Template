{
  "ErrorHandlingModule": {
    "GlobalExceptionHandler": {
      "Enabled": true,
      "IncludeExceptionDetails": false,
      "IncludeStackTrace": false,
      "CustomErrorPath": null
    },
    "ProblemDetails": {
      "Enabled": true,
      "IncludeTraceId": true,
      "CustomErrorTitles": {
        "400": "Bad Request",
        "401": "Unauthorized",
        "403": "Forbidden",
        "404": "Not Found",
        "500": "Internal Server Error"
      },
      "CustomErrorLinks": {}
    },
    "ModelStateValidation": {
      "Enabled": true,
      "SuppressModelStateInvalidFilter": true,
      "SuppressMapClientErrors": true
    }
  }
}
