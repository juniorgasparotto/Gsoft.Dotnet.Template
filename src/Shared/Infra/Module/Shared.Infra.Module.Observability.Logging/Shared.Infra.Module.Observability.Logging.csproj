<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="*" />
    <PackageReference Include="OpenTelemetry" Version="*" />
    <PackageReference Include="Serilog.AspNetCore" Version="*" />

    <PackageReference Include="Serilog.Enrichers.Environment" Version="*" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="*" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="*" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" Version="*" />
    <PackageReference Include="Serilog.Enrichers.Span" Version="*" />
    <PackageReference Include="Serilog.Enrichers.AssemblyName" Version="*" />
    <PackageReference Include="Serilog.Enrichers.ClientInfo" Version="*" />

    <PackageReference Include="Serilog.Settings.Configuration" Version="*" />
    <PackageReference Include="Serilog.Sinks.Async" Version="*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="*" />
    <PackageReference Include="Serilog.Sinks.File" Version="*" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="*" />
    <PackageReference Include="Serilog.Sinks.PeriodicBatching" Version="*" />
    
    <!--  -->
    <PackageReference Include="Ben.Demystifier" Version="*" />
    
    <!-- DATABASE LOGS -->
    <!--<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.2" />-->
    <PackageReference Include="Npgsql" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)Shared\Infra\Module\Shared.Infra.Module.Base\Shared.Infra.Module.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Serilog.MinimalLevel.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Serilog.Enrich.CallerInfo.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Serilog.Base.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Serilog.WriteTo.OpenTelemetry.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Serilog.WriteTo.Postgres.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
