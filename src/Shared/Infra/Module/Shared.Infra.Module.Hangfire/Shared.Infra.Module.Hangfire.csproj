<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.*" />
    <PackageReference Include="Hangfire.Storage.SQLite" Version="*" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.*" />
    <!-- Sobrescreve dependência transitiva para usar RIDs portáteis (evita NETSDK1206) -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SharedRoot)\Infra\Module\Shared.Infra.Module.Base\Shared.Infra.Module.Base.csproj" />
  </ItemGroup>

</Project>
