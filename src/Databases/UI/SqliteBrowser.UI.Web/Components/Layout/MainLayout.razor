@inherits LayoutComponentBase

<div class="app">
    <header class="app-header">
        <h1>SQLite Browser</h1>
        @if (!string.IsNullOrEmpty(State.DatabasesFolderPath))
        {
            <span class="path">@State.DatabasesFolderPath</span>
        }
    </header>
    <main class="app-main">
        @Body
    </main>
</div>

@code {
    [CascadingParameter] public SqliteBrowserStateService State { get; set; } = null!;
}
